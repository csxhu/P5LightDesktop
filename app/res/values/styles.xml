<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">#ff111719</item>
        <item name="android:windowBackground">#ff111719</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/PanelDialog</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#ff77e4bf</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="PanelDialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:colorBackground">#ff1c2529</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:windowBackground">#ff1c2529</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowMinWidthMajor">0.0%</item>
        <item name="android:windowMinWidthMinor">0.0%</item>
    </style>
</resources>
